# Set paths to writable locations because nginx runs non-root.
proxy_temp_path /tmp/proxy_temp;
client_body_temp_path /tmp/client_temp;
fastcgi_temp_path /tmp/fastcgi_temp;
uwsgi_temp_path /tmp/uwsgi_temp;
scgi_temp_path /tmp/scgi_temp;

server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server ipv6only=on;

  # Generic default server so no private hostname is stored in the image.
  server_name _;

  ssl_certificate /ssl/fullchain.pem;
  ssl_certificate_key /ssl/privkey.pem;

  # The global nginx config already defines the session cache,
  # timeout, and ticket settings.
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 512M;

  # Serve media files.
  location /media {
    alias ${MEDIA_ROOT};
    add_header Content-Disposition 'attachment; filename="$args"';
  }

  # Serve the service worker under the main path.
  location = /service-worker.js {
    alias ${STATIC_ROOT}/vue3/service-worker.js;
  }

  # Pass dynamic requests to Gunicorn through Tandoor's Unix socket.
  location / {
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    proxy_pass http://unix:/tmp/tandoor.sock;

    # Disabled because of the existing error-page redirect behavior.
    # error_page 502 /errors/http502.html;
  }

  location /errors/ {
    alias /etc/nginx/http.d/errorpages/;
    internal;
  }
}
